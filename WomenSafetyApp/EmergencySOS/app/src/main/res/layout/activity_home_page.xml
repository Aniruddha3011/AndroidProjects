<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/img_bg"
    android:fillViewport="true"
    android:padding="30dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Profile Section -->
        <LinearLayout
            android:id="@+id/profile_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileimage"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:src="@drawable/user"
                android:clickable="true"
                android:background="@drawable/circle_bg"
                android:focusable="true"/>

            <TextView
                android:id="@+id/hello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello,"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Horizontal Image Scroll -->
        <HorizontalScrollView
            android:id="@+id/image_scroll"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image_border"
                    android:clipToOutline="true"
                    android:src="@drawable/firstimg"
                    android:outlineProvider="background" />

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image_border"
                    android:clipToOutline="true"
                    android:src="@drawable/secondimg" />

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image_border"
                    android:clipToOutline="true"
                    android:src="@drawable/thirdimage" />

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/rounded_image_border"
                    android:clipToOutline="true"
                    android:src="@drawable/fourthimg" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Ask AI Button -->
        <Button
            android:id="@+id/ai_tip_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Ask AI For Safety Tips..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/rounded_bg"
            android:layout_marginTop="30dp"/>

        <!-- Grid Buttons -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/grid_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="4dp"
            app:alignmentMode="alignMargins"
            app:columnCount="2"
            app:rowCount="2">

            <!-- Add Emergency Contacts -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_bg"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_columnWeight="1">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/round_add_ic_call_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add\nEmergency\nContacts"
                    android:textColor="#F9F8FA"
                    android:id="@+id/AddEmergencyNo"
                    android:textSize="20sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Safety Check-In -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_bg"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_columnWeight="1">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/shield"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safety\nCheck-In"
                    android:textColor="#F9F8FA"
                    android:textSize="20sp"
                    android:id="@+id/safetycheckin"
                    android:paddingTop="10dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Fake Call -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_bg"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_columnWeight="1">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/outline_phone_callback_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fake Call"
                    android:textColor="#F9F8FA"
                    android:textSize="20sp"
                    android:id="@+id/Fakecall"
                    android:paddingTop="10dp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- Report Incident -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="175dp"
                android:layout_margin="8dp"
                android:background="@drawable/rounded_bg"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_columnWeight="1">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/outline_article_24"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report\nIncident"
                    android:textColor="#F9F8FA"
                    android:textSize="20sp"
                    android:id="@+id/report"
                    android:gravity="center" />
            </LinearLayout>
        </androidx.gridlayout.widget.GridLayout>

        <!-- Bottom Navigation + SOS Button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="20dp">

            <!-- Bottom Nav -->
            <LinearLayout
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/rounded_bg2"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="10dp">

                <LinearLayout
                    android:id="@+id/nav_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="30dp"
                        android:id="@+id/home"
                        android:src="@drawable/outline_add_home_24"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_shortcut"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="30dp"
                        android:id="@+id/viewaudiorecording"
                        android:src="@drawable/outline_blur_short_24"
                        app:tint="#FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shortcut"
                        android:id="@+id/shortcut"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- SOS Button -->
            <FrameLayout
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_gravity="center"
                android:background="@drawable/button_bg"
                android:elevation="10dp">

                <TextView
                    android:id="@+id/sosbutton"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="SOS"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textSize="18sp" />
            </FrameLayout>
        </FrameLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
